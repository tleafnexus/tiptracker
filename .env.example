# Copy this file to .env and fill it in. .env is never overwritten by updates.
PORT=8000
APP_PASSWORD=change-me
TZ=America/Denver
# Behind HTTPS (reverse proxy or Cloudflare Tunnel): log in only via the https:// address
# SECURE_COOKIES=1
# Behind a Cloudflare Tunnel: count failed logins per real visitor, not per tunnel
# TRUST_CLOUDFLARE=1
